# cp .env.example .env
# docker compose overrides DATABASE_URL to point at its postgres service.
APP_ENV=development
LOG_LEVEL=INFO
API_PORT=8000

# Settings for backend/scripts/seed_api.sh
# API_URL is used by backend/scripts/seed_api.sh.
API_URL=http://localhost:8000/api/v1
PARALLELISM=8
VERBOSE=1

POSTGRES_DB=safecall
POSTGRES_USER=safecall
POSTGRES_PASSWORD=safecall
POSTGRES_PORT=5432
# Used when running the backend outside Docker.
DATABASE_URL=postgresql+asyncpg://safecall:safecall@127.0.0.1:5432/safecall

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-production
JWT_EXPIRE_DAYS=30
ADMIN_API_KEY=change-me-admin-key
ADMIN_TOKEN_EXPIRE_HOURS=12
# APP_ENV=production refuses to start while JWT_SECRET / ADMIN_API_KEY are placeholders or < 32 chars.

DEFAULT_REGION=MD

# Optional. Without a key, free-text complaints fall back to the checkbox fingerprint.
GEMINI_API_KEY=
# More keys, comma-separated: a key that hits its quota (429) or is rejected is skipped automatically.
GEMINI_API_KEYS=
GEMINI_MODEL=gemini-3.8-flash
# Thinking: empty = model default. Gemini 3: minimal|low|medium|high. Gemini 2.5: GEMINI_THINKING_BUDGET=0 turns it off.
GEMINI_THINKING_LEVEL=
GEMINI_THINKING_BUDGET=
GEMINI_RETRY_ATTEMPTS=2
LLM_TIMEOUT_SECONDS=8

# Rate limits + fingerprint cache shared by all API workers. Empty = in-process memory.
# docker compose sets it to redis://redis:6379/0 itself; this value is for running the API on the host.
REDIS_URL=redis://localhost:6379/0
REDIS_PORT=6379

RATE_LIMIT_ENABLED=true
RATE_LIMIT_REPORT=10/hour
RATE_LIMIT_FEEDBACK=20/hour
RATE_LIMIT_CHECK=60/minute
RATE_LIMIT_ASSISTANT=20/hour
ASSISTANT_TIMEOUT_SECONDS=20
ASSISTANT_MAX_OUTPUT_TOKENS=2048

SCHEDULER_ENABLED=true
RECALC_INTERVAL_MINUTES=5
FULL_RECALC_HOUR_UTC=3

# Report ageing: full weight for the grace period, then halves every half-life.
REPORT_GRACE_DAYS=30
REPORT_HALF_LIFE_DAYS=90

# JSON list. Docker Compose sets the internal service URLs automatically.
CORS_ORIGINS=["*"]

# Admin panel
ADMIN_JWT_SECRET=change-me-admin-secret
ADMIN_JWT_ALGORITHM=HS256
ADMIN_ACCESS_TOKEN_EXPIRE_MINUTES=60

BOOTSTRAP_ADMIN_USERNAME=mainadmin
BOOTSTRAP_ADMIN_PASSWORD=change-me-admin-password

DATA_SOURCE=mock
MOCK_MODE=true
ADMIN_API_PORT=8100
ADMIN_MORDA_PORT=5173
