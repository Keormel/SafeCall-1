# cp .env.example .env
# docker compose overrides DATABASE_URL to point at its postgres service.
APP_ENV=development
LOG_LEVEL=INFO
API_PORT=8000
DASHBOARD_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000

POSTGRES_DB=safecall
POSTGRES_USER=safecall
POSTGRES_PASSWORD=safecall
POSTGRES_PORT=5432
# Used only when running the backend outside docker (SQLite: sqlite+aiosqlite:///./safecall.db)
DATABASE_URL=postgresql+asyncpg://safecall:safecall@localhost:5432/safecall

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-production
JWT_EXPIRE_DAYS=30
ADMIN_API_KEY=change-me-admin-key
ADMIN_TOKEN_EXPIRE_HOURS=12
# APP_ENV=production refuses to start while JWT_SECRET / ADMIN_API_KEY are placeholders or < 32 chars.

DEFAULT_REGION=MD

# Optional. Without a key, free-text complaints fall back to the checkbox fingerprint.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
LLM_TIMEOUT_SECONDS=8

# Rate limits + fingerprint cache shared by all API workers. Empty = in-process memory.
# docker compose sets it to redis://redis:6379/0 itself; this value is for running the API on the host.
REDIS_URL=redis://localhost:6379/0
REDIS_PORT=6379

RATE_LIMIT_ENABLED=true
RATE_LIMIT_REPORT=10/hour
RATE_LIMIT_CHECK=60/minute

SCHEDULER_ENABLED=true
RECALC_INTERVAL_MINUTES=5
FULL_RECALC_HOUR_UTC=3

# Report ageing: full weight for the grace period, then halves every half-life.
REPORT_GRACE_DAYS=30
REPORT_HALF_LIFE_DAYS=90

# JSON list
CORS_ORIGINS=["*"]
