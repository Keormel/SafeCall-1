# Copy to .env and adjust. docker-compose overrides DATABASE_URL to point at its postgres service.
APP_ENV=development
LOG_LEVEL=INFO

# Local run without docker (SQLite):  sqlite+aiosqlite:///./safecall.db
DATABASE_URL=postgresql+asyncpg://safecall:safecall@localhost:5433/safecall
POSTGRES_DB=safecall
POSTGRES_USER=safecall
POSTGRES_PASSWORD=safecall
POSTGRES_PORT=5433
API_PORT=8000

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-production
JWT_EXPIRE_DAYS=30
ADMIN_API_KEY=change-me-admin-key

DEFAULT_REGION=MD

# Optional. Without a key, free-text complaints fall back to the checkbox fingerprint.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
LLM_TIMEOUT_SECONDS=8

RATE_LIMIT_ENABLED=true
RATE_LIMIT_REPORT=10/hour
RATE_LIMIT_CHECK=60/minute

SCHEDULER_ENABLED=true
RECALC_INTERVAL_MINUTES=5

# JSON list
CORS_ORIGINS=["*"]
